# API credentials are now configured at runtime from the in-app Settings modal
# (top-right gear icon in the header). Values are saved to localStorage in your
# browser. No environment variables are required to run the app.
#
# Environment URLs are bundled as constants in src/config/environments.ts and
# selected via the Settings modal:
#
#   Sandbox
#     Payment API:        https://api-sandbox.n1co.shop/api/v3
#     Checkout Link API:  https://api-pay-sandbox.n1co.shop/api
#
#   Live
#     Payment API:        https://api.n1co.com/api/v3
#     Checkout Link API:  https://api-pay.n1co.shop/api
